{
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false
    },
    "agent_servers": {
        "claude-acp": {
            "default_config_options": {
                "effort": "high",
                "model": "opus"
            },
            "type": "registry"
        }
    },
    "agent": {
        "dock": "right",
        "threads_sidebar": {
            "position": "right"
        },
        "favorite_models": [],
        "model_parameters": []
    },
    "feature_flags": {
        "notebooks": "on",
        "tabular-data-preview": "on"
      },
  "session": {
    "trust_all_worktrees": true
  },
  "buffer_line_height": "comfortable",
  "buffer_font_family": "IBM Plex Mono",
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "off",
  "disable_ai": false,
  "vim_mode": true,
  "tab_size": 4,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "file_types": {
    "xml": [
      "*.sdf",
      "*.xacro"
    ],
    "yaml": [
      "*.repos"
    ],
    "shellscript": [
      "*.in"
    ],
    "latex": [
      "*.tex"
    ]
  },
  "languages": {
    "C++": {
      "tab_size": 4,
      "hard_tabs": false
    },
    "C": {
      "tab_size": 4,
      "hard_tabs": false
    }
  },
  "soft_wrap": "editor_width",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Hard",
    "dark": "High Contrast Ayu"
  },
  "theme_overrides": {
    "High Contrast Ayu": {
      "border": "#333333",
      "border.variant": "#222222"
    }
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "latexmk",
            "args": [
              "-silent",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-pdf",
              "%f"
            ],
            "onSave": true
          }
        }
      }
    }
  }
}
