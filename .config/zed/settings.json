// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "buffer_line_height": "comfortable",
  "buffer_font_family": ".ZedMono",
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "off",
  "disable_ai": true,
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "file_types": {
    "xml": [
      "*.sdf",
      "*.xacro"
    ],
    "yaml": [
      "*.repos"
    ],
    "shellscript": [
      "*.in"
    ],
    "latex": [
      "*.tex"
    ]
  },
  "soft_wrap": "editor_width",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Hard",
    "dark": "High Contrast Ayu"
  },
  "theme_overrides": {
    "High Contrast Ayu": {
          "border": "#333333",
          "border.variant": "#222222",
        }
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "latexmk",
            "args": [
              "-silent",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-pdf",
              "%f"
            ],
            "onSave": true
          }
        }
      }
    }
  }
}
