
{
	// Place your snippets for latex here. Each snippet is defined under a snippet name and has a prefix, body and
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"latex_image": {
		"prefix": ["img", "begin figure"],
		"body": [
			"\\begin{figure}",
			"\t\\centering",
			"\t\\includegraphics[width=${2:\\textwidth}]{${3:figures/example.png}}",
			"\t\\caption{${4:Descripción de la figura}}",
			"\t\\label{fig:${5:label}}",
			"\\end{figure}"
		],
		"description": "Insertar imagen con entorno figure en LaTeX"
	},
	"latex_two_images_with_global_caption": {
			"prefix": ["img2", "begin figure two global"],
			"body": [
				"\\begin{figure}",
				"\t\\centering",
				"\t\\begin{subfigure}[c]{0.45\\textwidth}",
				"\t\t\\centering",
				"\t\t\\includegraphics[width=\\textwidth]{${1:figures/image1.png}}",
				"\t\t\\caption{${2:Subtítulo de la primera imagen}}",
				"\t\t\\label{fig:${3:label1}}",
				"\t\\end{subfigure}",
				"\t\\hfill",
				"\t\\begin{subfigure}[c]{0.45\\textwidth}",
				"\t\t\\centering",
				"\t\t\\includegraphics[width=\\textwidth]{${4:figures/image2.png}}",
				"\t\t\\caption{${5:Subtítulo de la segunda imagen}}",
				"\t\t\\label{fig:${6:label2}}",
				"\t\\end{subfigure}",
				"",
				"\t\\caption{${7:Descripción general de ambas imágenes}}",
				"\t\\label{fig:${8:label_global}}",
				"\\end{figure}"
			],
			"description": "Insertar dos imágenes lado a lado con subcaptions y un caption general en LaTeX (usa el paquete subcaption)"
		}
}
