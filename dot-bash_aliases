function update() {
    UPDATE_DRIVERS=false

    while getopts "d" opt; do
        case ${opt} in
            d )
                UPDATE_DRIVERS=true
                ;;
            \? )
                echo "Usage: update [-d]"
                return 1
                ;;
        esac
    done

    sudo apt update -y &&\
    sudo apt upgrade -y

    if [ "$UPDATE_DRIVERS" ]; then
	echo "Nvidia drivers will be updated"
        sudo ubuntu-drivers install
    fi

    sudo apt autoremove -y &&\
    omz update &&\
    sudo snap refresh &&\
    echo "System updated correctly!" || \
    echo "Error in the installation"
}


function dexec() {
    docker exec -it $1 bash
}

function dbender {
    dexec bender_core

}

function status {

    find . -name .git -type d -prune | while read -r gitdir; do
        repo=$(dirname "$gitdir")
        echo "========================================"
        echo "📁 Repositorio: $repo"
        echo "========================================"
        git -C "$repo" status -s
        echo ""
    done
}

function ghtoken {
